#!/usr/bin/env python3
"""Cook the square portrait crop declared in the poster HDA parameters."""

# 2026-09-17 06:00, crop values stay in _params.json so the portrait remains editable.
from pathlib import Path
import json

from PIL import Image


ROOT = Path(__file__).resolve().parents[1]


def main() -> None:
    params = json.loads((ROOT / "_params.json").read_text(encoding="utf-8"))
    crop = params["portraitCrop"]
    source = Image.open(ROOT / crop["source"]).convert("RGB")
    left = int(crop["left"])
    top = int(crop["top"])
    size = int(crop["size"])
    box = (left, top, left + size, top + size)
    if box[2] > source.width or box[3] > source.height:
        raise SystemExit(f"Portrait crop {box} exceeds source {source.size}")
    result = source.crop(box)
    output = ROOT / crop["output"]
    result.save(output, quality=100)
    if result.size != (size, size):
        raise SystemExit(f"Expected square crop, got {result.size}")
    print(f"{output}: {result.width}x{result.height}")


if __name__ == "__main__":
    main()
