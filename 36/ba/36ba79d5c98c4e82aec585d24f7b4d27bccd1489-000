#!/usr/bin/env python3
"""Build the 4K measurement guide for the source reference."""

# 2026-09-16 23:59, annotations are measured in source pixels then scaled by three.
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont


ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / "assets" / "reference.png"
OUTPUT = ROOT / "templates" / "procedural-modeling-commercial" / "template-guide.png"
SCALE = 3
BAND_HEIGHT = 300


def scaled_box(box: tuple[int, int, int, int]) -> tuple[int, int, int, int]:
    return tuple(value * SCALE for value in box)


def main() -> None:
    source = Image.open(SOURCE).convert("RGBA")
    enlarged = source.resize((source.width * SCALE, source.height * SCALE), Image.Resampling.LANCZOS)
    guide = Image.new("RGBA", (enlarged.width, enlarged.height + BAND_HEIGHT), (19, 20, 19, 255))
    guide.paste(enlarged, (0, 0))
    overlay = Image.new("RGBA", guide.size, (0, 0, 0, 0))
    draw = ImageDraw.Draw(overlay)
    colors = {
        "panel": (0, 170, 255, 30),
        "main": (255, 45, 145, 30),
        "secondary": (0, 230, 235, 30),
        "media": (255, 185, 30, 30),
        "axis": (45, 230, 120, 180),
    }
    panel = [(0, 0), (696 * SCALE, 0), (533 * SCALE, 900 * SCALE), (0, 900 * SCALE)]
    draw.polygon(panel, fill=colors["panel"], outline=(0, 170, 255, 180), width=1)
    draw.rectangle(scaled_box((94, 190, 512, 302)), fill=colors["main"], outline=(255, 45, 145, 180), width=1)
    draw.rectangle(scaled_box((96, 307, 536, 406)), fill=colors["secondary"], outline=(0, 230, 235, 180), width=1)
    draw.rectangle(scaled_box((530, 0, 1600, 900)), fill=colors["media"], outline=(255, 185, 30, 180), width=1)
    draw.line((0, 450 * SCALE, 1600 * SCALE, 450 * SCALE), fill=colors["axis"], width=1)
    guide = Image.alpha_composite(guide, overlay)
    band = ImageDraw.Draw(guide)
    font_path = "/Users/zenray/Library/Fonts/SF-Pro-Display-Bold.otf"
    title_font = ImageFont.truetype(font_path, 58)
    body_font = ImageFont.truetype(font_path, 32)
    band.text((90, enlarged.height + 48), "PROCEDURAL MODELING COMMERCIAL · TEMPLATE GUIDE", font=title_font, fill=(197, 200, 205, 255))
    band.text((90, enlarged.height + 135), "BLUE: INFORMATION PANEL   PINK: PRIMARY TITLE   CYAN: SECONDARY TITLE   ORANGE: MEDIA FIELD   GREEN: MIDLINE", font=body_font, fill=(241, 158, 70, 255))
    band.text((90, enlarged.height + 202), "SOURCE 1600 × 900 · GUIDE 4800 × 3000 · MEASUREMENTS STORED IN template-spec.json", font=body_font, fill=(133, 137, 143, 255))
    guide.convert("RGB").save(OUTPUT, quality=95)
    print(OUTPUT)


if __name__ == "__main__":
    main()
