def render_card_v2(line, size, color=(239, 159, 71)):
    font_g = ImageFont.truetype(f_garamond, size)
    font_sf = ImageFont.truetype(f_sf_reg, size)
    faces_spec = {k: ImageFont.truetype(v, size) for k, v in K_SPECIAL.items()}
    
    words = line.split(' ')
    word_data = []
    for w in words:
        if any(c in faces_spec for c in w):
            char_runs = []
            for c in w:
                face = faces_spec[c] if c in faces_spec else font_sf
                char_runs.append((c, face, face.getlength(c)))
            w_len = sum(x[2] for x in char_runs)
            word_data.append(('special', char_runs, w_len))
        else:
            word_data.append(('garamond', w, font_g.getlength(w)))

    space = 32
    total_w = sum(x[2] for x in word_data) + space * (len(word_data) - 1)
    pad = 120
    card_w = int(total_w + pad * 2)
    card_h = int(size * 1.6 + pad * 2)

    shadow = Image.new('RGBA', (card_w, card_h), (0, 0, 0, 0))
    d_sh = ImageDraw.Draw(shadow)
    text_l = Image.new('RGBA', (card_w, card_h), (0, 0, 0, 0))
    d_tx = ImageDraw.Draw(text_l)

    base_y = pad + int(size * 1.1)
    off_y = 36
    sh_color = (0, 0, 0, 230)

    cur_x = pad
    for item in word_data:
        if item[0] == 'garamond':
            w = item[1]
            d_sh.text((cur_x, base_y + off_y), w, font=font_g, fill=sh_color, anchor='ls')
            d_tx.text((cur_x, base_y), w, font=font_g, fill=color, anchor='ls')
            cur_x += item[2] + space
        else:
            for c, face, clen in item[1]:
                d_sh.text((cur_x, base_y + off_y), c, font=face, fill=sh_color, anchor='ls')
                d_tx.text((cur_x, base_y), c, font=face, fill=color, anchor='ls')
                cur_x += clen
            cur_x += space

    shadow = shadow.filter(ImageFilter.GaussianBlur(radius=16))
    card = Image.alpha_composite(shadow, text_l)
    return card, shadow, text_l, total_w

def make_dust_frames_inplace(card, shadow, text_l, n_dust=12):
    """Generates in-place 360-degree organic particle disintegration."""
    arr_tx = np.array(text_l)
    H, W = arr_tx.shape[:2]
    
    y_idx, x_idx = np.where(arr_tx[:, :, 3] > 40)
    if len(y_idx) == 0:
        return [card] * n_dust
    
    colors = arr_tx[y_idx, x_idx]
    n_pts = len(y_idx)
    
    rng = np.random.RandomState(42 + n_pts % 777)
    # Pure symmetrical 360-degree diffusion (zero sideways drift)
    angles = rng.uniform(0, 2 * np.pi, n_pts)
    speeds = rng.uniform(1.2, 5.0, n_pts)
    vx = np.cos(angles) * speeds
    vy = np.sin(angles) * speeds
    
    # Pure in-place random organic delay
    delay = rng.uniform(0, 3.0, n_pts)
    
    dust_frames = []
    for f in range(n_dust):
        # Shadow dissolves in place
        sh_a = max(0.0, 1.0 - f / (n_dust * 0.55))
        cur_sh = shadow.point(lambda p, a=sh_a: int(p * a))
        
        t = np.maximum(0, f - delay)
        cur_x = np.clip(np.round(x_idx + vx * t).astype(int), 0, W - 1)
        cur_y = np.clip(np.round(y_idx + vy * t).astype(int), 0, H - 1)
        
        # Fast alpha fadeout
        p_alpha = np.clip(colors[:, 3] * np.maximum(0.0, 1.0 - t / 6.5), 0, 255).astype(np.uint8)
        
        layer = np.zeros((H, W, 4), dtype=np.uint8)
        layer[cur_y, cur_x] = np.column_stack([colors[:, :3], p_alpha])
        
        # Sparkle flecks (25%)
        glow_idx = np.where((t > 0) & (t < 4) & (rng.uniform(0, 1, n_pts) < 0.25))[0]
        if len(glow_idx) > 0:
            gx = np.clip(cur_x[glow_idx] + 1, 0, W - 1)
            gy = np.clip(cur_y[glow_idx], 0, H - 1)
            layer[gy, gx] = np.column_stack([colors[glow_idx, :3], (p_alpha[glow_idx] * 0.5).astype(np.uint8)])
            
        p_im = Image.fromarray(layer)
        comp = Image.alpha_composite(cur_sh, p_im)
        dust_frames.append(comp)
    return dust_frames

def build_line_frames(card, shadow, text_l, cy, n_dust=12):
    in_frames = []
    for scale, alpha in punch_curve:
        if alpha <= 0:
            in_frames.append(None)
            continue
        r = card.resize((int(card.width * scale), int(card.height * scale)), Image.Resampling.BILINEAR)
        if alpha < 1:
            r.putalpha(r.getchannel('A').point(lambda p, a=alpha: int(p * a)))
        in_frames.append((r, W // 2 - r.width // 2, cy - r.height // 2))
    
    steady = (card, W // 2 - card.width // 2, cy - card.height // 2)
    
    raw_dust = make_dust_frames_inplace(card, shadow, text_l, n_dust=n_dust)
    out_frames = [(df, W // 2 - df.width // 2, cy - df.height // 2) for df in raw_dust]
    return in_frames, steady, out_frames

