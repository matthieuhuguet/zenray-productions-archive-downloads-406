# 3. Render Subtitle Card (Cue 10 with kaomoji)
def render_card_v2(line, size):
    c_sub = (239, 159, 71)
    font_g = ImageFont.truetype(f_garamond, size)
    font_sf = ImageFont.truetype(f_sf_reg, size)
    faces_spec = {k: ImageFont.truetype(v, size) for k, v in K_SPECIAL.items()}
    
    words = line.split(' ')
    word_data = []
    for w in words:
        if any(c in K_SPECIAL for c in w):
            char_runs = []
            for c in w:
                f = faces_spec[c] if c in K_SPECIAL else font_sf
                char_runs.append((c, f, f.getlength(c)))
            w_len = sum(x[2] for x in char_runs)
            word_data.append(('special', char_runs, w_len))
        else:
            word_data.append(('garamond', w, font_g.getlength(w)))
            
    space = 32
    total_w = sum(x[2] for x in word_data) + space * (len(word_data) - 1)
    
    pad = 120
    card_w = int(total_w + pad * 2)
    card_h = int(size * 1.6 + pad * 2)
    
    card = Image.new('RGBA', (card_w, card_h), (0, 0, 0, 0))
    shadow = Image.new('RGBA', (card_w, card_h), (0, 0, 0, 0))
    d_sh = ImageDraw.Draw(shadow)
    text_l = Image.new('RGBA', (card_w, card_h), (0, 0, 0, 0))
    d_tx = ImageDraw.Draw(text_l)
    
    base_y = pad + int(size * 1.1)
    off_y = 36 # ~40px drop shadow
    
    cur_x = pad
    for item in word_data:
        if item[0] == 'garamond':
            w = item[1]
            d_sh.text((cur_x, base_y + off_y), w, font=font_g, fill=(0, 0, 0, 230), anchor='ls')
            d_tx.text((cur_x, base_y), w, font=font_g, fill=c_sub, anchor='ls')
            cur_x += item[2] + space
        else:
            for c, f, clen in item[1]:
                d_sh.text((cur_x, base_y + off_y), c, font=f, fill=(0, 0, 0, 230), anchor='ls')
                d_tx.text((cur_x, base_y), c, font=f, fill=c_sub, anchor='ls')
                cur_x += clen
            cur_x += space
            
    shadow = shadow.filter(ImageFilter.GaussianBlur(radius=16))
    card.paste(shadow, (0, 0), shadow)
    card.paste(text_l, (0, 0), text_l)
    return card

